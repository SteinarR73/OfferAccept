# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/offeraccept_dev"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"

# ─── Redis (Rate Limiting) ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_TLS="false"
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=500
RATE_LIMIT_BACKEND="redis"

# ─── Auth / Session ──────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
# JWT_SECRETS="old-secret-1,old-secret-2"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=""
COOKIE_SECURE="true"

# ─── Signing Links ───────────────────────────────────────────────────────────
# Secret used to sign recipient tokens in email links
SIGNING_LINK_SECRET="change-me-in-production-min-32-chars"
TOKEN_EXPIRY_DAYS=30

# ─── Email (Resend or SMTP) ───────────────────────────────────────────────────
EMAIL_PROVIDER="dev"  # "dev" | "resend"
RESEND_API_KEY=""
EMAIL_FROM="noreply@offeraccept.com"

# ─── Storage (S3-compatible) ──────────────────────────────────────────────────
STORAGE_PROVIDER="dev" # "dev" | "s3"
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
BILLING_PROVIDER="none" # "none" | "stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_ENTERPRISE=""

# ─── Legal ────────────────────────────────────────────────────────────────────
# Enable strict legal compliance mode (required for EEA production deployments).
# When true: acceptance statement must be non-empty; GDPR Article 14 notice is
# unconditionally rendered before OTP (enforced client-side — always on).
LEGAL_MODE_STRICT=true

# ─── Webhooks & Security ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting sensitive database columns.
# Must be exactly 64 hex characters (32 bytes). Required in production.
WEBHOOK_SECRET_KEY=""
TRUST_PROXY="false"
TRUSTED_PROXY_CIDR=""

# ─── Observability & Sentry ───────────────────────────────────────────────────
# Expose the Prometheus /metrics endpoint. Disabled by default.
ENABLE_METRICS=false
SENTRY_DSN=""
APP_VERSION=""

# ─── Support Access ───────────────────────────────────────────────────────────
SUPPORT_IP_ALLOWLIST=""
SUPPORT_SESSION_TTL_MINUTES=480
REQUIRE_SUPPORT_MFA="false"

# ─── AI / Gemini ──────────────────────────────────────────────────────────────
AI_PROVIDER="none" # "none" | "gemini"
GEMINI_API_KEY=""
AI_DAILY_TOKEN_LIMIT=0
AI_DEFAULT_MODEL="gemini-2.0-flash"
AI_CALL_TIMEOUT_MS=30000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000
AI_MAX_RETRIES=3

# ─── Data Retention ───────────────────────────────────────────────────────────
# Retention period for acceptance evidence (years).
# Records are preserved for legal claim support under GDPR Art. 17(3)(e).
ACCEPTANCE_RETENTION_YEARS=10
# Retention period for active deal event rows before archival to cold storage.
DEAL_EVENT_RETENTION_MONTHS=18
